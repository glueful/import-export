{
    "name": "glueful/import-export",
    "description": "Import and export engine for Glueful apps.",
    "type": "glueful-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Tawiah Sowah",
            "email": "michael@glueful.dev"
        }
    ],
    "keywords": [
        "glueful",
        "import",
        "export",
        "csv",
        "json",
        "ndjson",
        "batch"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "glueful/framework": "^1.57.0",
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "homepage": "https://github.com/glueful/import-export",
    "autoload": {
        "psr-4": {
            "Glueful\\Extensions\\ImportExport\\": "src/"
        },
        "classmap": [
            "migrations/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Glueful\\Extensions\\ImportExport\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyze": "vendor/bin/phpstan analyse",
        "phpcbf": "vendor/bin/phpcbf --standard=PSR12 src",
        "phpcs": "vendor/bin/phpcs --standard=PSR12 src",
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "glueful": {
            "name": "Import Export",
            "displayName": "Import Export",
            "description": "Import and export engine for Glueful apps.",
            "version": "1.1.0",
            "categories": [
                "data",
                "operations"
            ],
            "publisher": "glueful-team",
            "provider": "Glueful\\Extensions\\ImportExport\\ImportExportServiceProvider",
            "requires": {
                "glueful": ">=1.57.0",
                "extensions": []
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
